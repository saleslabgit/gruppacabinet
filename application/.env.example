APP_NAME="Gruppa Cabinet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080/cabinet
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gruppa_cabinet
DB_USERNAME=cabinet
DB_PASSWORD=cabinet_local

SESSION_DRIVER=database
SESSION_COOKIE=gruppa_cabinet_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Web, cron scheduler and workers must share this store and prefix.
# CACHE_PREFIX=gruppa-cabinet-cache-
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
# SMTP socket timeout only; does not apply to sendmail.
MAIL_TIMEOUT=15
# Optional production/shared-hosting transport command (local stays SMTP/Mailpit):
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PSYCHOLOGIST_DOCUMENT_MAX_KB=10240

# Server-to-server integration; provision the secret outside version control.
INTEGRATION_SECRET=
INTEGRATION_TIMESTAMP_TOLERANCE=300
INTEGRATION_RATE_PER_MINUTE=60
INTEGRATION_ALLOWED_IPS=

WEBPAY_ENV=sandbox
WEBPAY_STORE_ID=
WEBPAY_SECRET_KEY=
WEBPAY_API_USERNAME=
WEBPAY_API_PASSWORD=
WEBPAY_HTTP_TIMEOUT=15
